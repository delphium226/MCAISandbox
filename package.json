{
  "name": "mcaisandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based Minecraft-style voxel sandbox with an authoritative server, built to host human and AI players.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mc:setup": "python mc/setup.py",
    "mc:server": "python mc/start.py",
    "mc:agents": "tsx server/src/mineflayer/index.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "minecraft-data": "^3.117.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "opentype.js": "^2.0.0",
    "prismarine-schematic": "^1.3.0",
    "three": "^0.186.1",
    "vec3": "^0.1.10",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
